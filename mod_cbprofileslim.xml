<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="4.0" client="site" method="upgrade">
	<name>Community Builder Profile Slim Display</name>
	<author>jaydenrussell</author>
	<creationDate>2026-08-19</creationDate>
	<copyright>Copyright (C) 2026 Simcoe Curling Club</copyright>
	<license>GNU General Public License v2 or later</license>
	<version>1.8.2</version>
	<description>Standalone Joomla module: displays the logged-in Community Builder user's display name and avatar in the top header navbar. Reads user data via the Community Builder API.</description>
	<updateservers>
		<server type="extension" name="Community Builder Profile Slim Display Update" priority="1">https://jaydenrussell.github.io/mod-cbprofileslim/update.xml</server>
	</updateservers>
	<files>
		<filename module="mod_cbprofileslim">mod_cbprofileslim.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
		<folder>language</folder>
		<folder>css</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/en-GB.mod_cbprofileslim.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.mod_cbprofileslim.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="profile_url"
					type="text"
					label="MOD_CBPROFILESLIM_PROFILE_URL_LABEL"
					description="MOD_CBPROFILESLIM_PROFILE_URL_DESC"
					default=""
					size="50"
					filter="url"
				/>
				<field
					name="avatar_base_path"
					type="text"
					label="MOD_CBPROFILESLIM_AVATAR_BASE_PATH_LABEL"
					description="MOD_CBPROFILESLIM_AVATAR_BASE_PATH_DESC"
					default="/images/comprofiler/"
					size="40"
					filter="string"
				/>
				<field
					name="avatar_size"
					type="list"
					label="MOD_CBPROFILESLIM_AVATAR_SIZE_LABEL"
					description="MOD_CBPROFILESLIM_AVATAR_SIZE_DESC"
					default="32"
				>
					<option value="16">16px</option>
					<option value="24">24px</option>
					<option value="32" selected="selected">32px</option>
					<option value="36">36px</option>
					<option value="40">40px</option>
				</field>
				<field
					name="avatar_align"
					type="list"
					label="MOD_CBPROFILESLIM_AVATAR_ALIGN_LABEL"
					description="MOD_CBPROFILESLIM_AVATAR_ALIGN_DESC"
					default="top"
				>
					<option value="none">None</option>
					<option value="top" selected="selected">Top</option>
					<option value="center">Center</option>
					<option value="bottom">Bottom</option>
				</field>
				<field
					name="container_padding"
					type="text"
					label="MOD_CBPROFILESLIM_CONTAINER_PADDING_LABEL"
					description="MOD_CBPROFILESLIM_CONTAINER_PADDING_DESC"
					default="0 0 0 0"
					size="20"
					filter="string"
				/>
				<field
					name="container_margin"
					type="text"
					label="MOD_CBPROFILESLIM_CONTAINER_MARGIN_LABEL"
					description="MOD_CBPROFILESLIM_CONTAINER_MARGIN_DESC"
					default="0"
					size="20"
					filter="string"
				/>
				<field
					name="avatar_db_fallback"
					type="radio"
					label="MOD_CBPROFILESLIM_AVATAR_DB_FALLBACK_LABEL"
					description="MOD_CBPROFILESLIM_AVATAR_DB_FALLBACK_DESC"
					default="0"
					class="btn-group btn-group-yesno"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
