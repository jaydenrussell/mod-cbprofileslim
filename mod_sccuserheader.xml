<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.0" client="site" method="upgrade">
	<name>SCC User Header</name>
	<author>CallerFlash</author>
	<creationDate>2026-08-18</creationDate>
	<copyright>Copyright (C) 2026 Simcoe Curling Club</copyright>
	<license>GNU General Public License v2 or later</license>
	<version>1.4.0</version>
	<description>Displays user avatar and display name in the top header navbar.</description>
	<files>
		<filename module="mod_sccuserheader">mod_sccuserheader.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
		<folder>language</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/en-GB.mod_sccuserheader.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.mod_sccuserheader.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="profile_url"
					type="text"
					label="Profile URL"
					default="https://simcoecurlingclub.ca/scc-profile"
					size="50"
				/>
				<field
					name="avatar_size"
					type="list"
					label="Avatar Size"
					default="32"
				>
					<option value="16">16px</option>
					<option value="24">24px</option>
					<option value="32" selected="selected">32px</option>
					<option value="36">36px</option>
					<option value="40">40px</option>
				</field>
				<field
					name="avatar_align"
					type="list"
					label="Avatar Vertical Alignment"
					default="top"
				>
					<option value="none">None</option>
					<option value="top" selected="selected">Top</option>
					<option value="center">Center</option>
					<option value="bottom">Bottom</option>
				</field>
				<field
					name="container_padding"
					type="text"
					label="Container Padding"
					description="Padding for the container (e.g. 0 0 0 0)"
					default="0 0 0 0"
					size="20"
				/>
				<field
					name="container_margin"
					type="text"
					label="Container Margin"
					description="Margin for the container (e.g. 0)"
					default="0"
					size="20"
				/>
				<field
					name="avatar_db_fallback"
					type="radio"
					label="Avatar DB Fallback"
					description="OFF (default): avatar uses Community Builder API only. If CB returns no image, the avatar is blank — proving CB API is in use. ON: falls back to a direct #__comprofiler database query when CB API returns nothing."
					default="0"
					class="btn-group btn-group-yesno"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				</fieldset>
		</fields>
	</config>
</extension>
